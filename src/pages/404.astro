---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Rio Tri Prayogo" description="Page not found. Return to Rio Tri Prayogo’s portfolio." noindex breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Page not found', path: '/404' }]}>
<main class="page">
    <header class="bar"><span>RIO / PORTFOLIO</span><span>~/404</span></header>
    <div class="stage">
      <p class="number" aria-hidden="true">404</p>
      <div class="message">
        <p class="status">Page not found</p>
        <h1>This path ends here.</h1>
        <p class="detail">This page may have moved, or the address may be mistyped.</p>
        <a class="back" href="/">Back to home <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <footer class="foot"><span>rio@portfolio:~$ cd /</span><a href="/">Home ↑</a></footer>
  </main>
</BaseLayout>
<style is:global>
    :root {
      color-scheme: dark;
      --paper: var(--night);
      --ink: #edf1f3;
      --muted: var(--night-muted);
      --line: var(--night-line);
      --accent: var(--night-muted);
    }
    * { box-sizing: border-box; }
    html { background: var(--paper); }
    body { margin: 0; color: var(--ink); font: 15px/1.65 var(--body); -webkit-font-smoothing: antialiased; }
    ::selection { background: var(--accent); color: var(--paper); }
    a { color: inherit; text-underline-offset: 4px; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
    .page { min-height: 100svh; display: flex; flex-direction: column; padding: 0 var(--gutter); }
    .bar, .foot { display: flex; justify-content: space-between; gap: 20px; font: 11px var(--mono); letter-spacing: .06em; text-transform: uppercase; }
    .bar { padding: 25px 0 20px; border-bottom: 1px solid var(--line); }
    .bar span:last-child, .foot span { color: var(--muted); }
    .stage { flex: 1; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(290px, .8fr); align-items: center; }
    .number { margin: 0; padding: 60px 20px 80px 0; color: var(--muted); font: 600 clamp(160px, 28vw, 420px)/.75 var(--display); letter-spacing: -.075em; }
    .message { padding: 55px 0 55px clamp(28px, 4vw, 68px); border-left: 1px solid var(--line); }
    .status { margin: 0 0 24px; color: var(--accent); font: 11px var(--mono); letter-spacing: .06em; text-transform: uppercase; }
    h1 { max-width: 520px; margin: 0 0 20px; font: 600 clamp(48px, 5.3vw, 82px)/.9 var(--display); letter-spacing: -.035em; }
    .detail { max-width: 370px; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.8; }
    .back { display: inline-flex; align-items: center; gap: 18px; margin-top: 36px; padding-bottom: 8px; border-bottom: 1px solid var(--accent); color: var(--ink); font: 11px var(--mono); letter-spacing: .07em; text-decoration: none; text-transform: uppercase; }
    .back span { transition: transform .2s ease; }
    .back:hover span { transform: translateX(4px); }
    .foot { padding: 19px 0 24px; border-top: 1px solid var(--line); }
    .foot a { text-decoration: none; }
    .foot a:hover { color: var(--accent); }
    @media (max-width: 760px) {
      .bar { padding-top: 20px; }
      .stage { display: block; padding: 62px 0 70px; }
      .number { padding: 0 0 42px; font-size: clamp(160px, 42vw, 280px); }
      .message { padding: 35px 0 0; border-left: 0; border-top: 1px solid var(--line); }
      h1 { font-size: clamp(52px, 13vw, 76px); }
    }
  
</style>
