---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Rio Tri Prayogo"
  description="Page not found. Return to Rio Tri Prayogo’s portfolio."
  noindex
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Page not found', path: '/404' }]}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="page-label">404</p>
    <h1 id="not-found-title">Not found.</h1>
    <a class="text-link" href="/">Home <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
